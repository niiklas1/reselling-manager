{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reselling-manager",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "previews": {}
}
